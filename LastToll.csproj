<Project Sdk="Godot.NET.Sdk/4.3.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>LastToll</RootNamespace>
    <Nullable>disable</Nullable>
    <!-- Keep the GDScript side callable: C# members use snake_case names on purpose. -->
    <NoWarn>$(NoWarn);IDE1006;CS8981</NoWarn>
  </PropertyGroup>

  <!--
    APK size: the Android (linux-bionic) runtime pack also ships Mono's *static*
    libraries (libmonosgen-2.0.a, libmono-component-*.a, ~51 MB). The game runs on
    CoreCLR (libcoreclr.so); a static .a can never be loaded at runtime, but Godot's
    exporter copies everything in the publish folder into the APK. Drop them right
    after publish, before the exporter reads the folder.
  -->
  <Target Name="LastTollTrimPublish" AfterTargets="Publish">
    <ItemGroup>
      <_HwUnusedStaticLibs Include="$(PublishDir)**/*.a" />
    </ItemGroup>
    <Delete Files="@(_HwUnusedStaticLibs)" />
    <Message Importance="high" Text="LastToll: removed unused static libraries: @(_HwUnusedStaticLibs->'%(Filename)%(Extension)')" Condition="'@(_HwUnusedStaticLibs)' != ''" />
  </Target>
</Project>
